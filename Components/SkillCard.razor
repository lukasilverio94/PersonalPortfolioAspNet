@using PersonalPortfolio.Models;

<div class="card skill-card col-md-6 col-lg-4 col-sm-12 mb-4">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Skill.Name</h5>
        <span class="card-text badge bg-secondary me-1">@Skill.Category</span>
        <span class="card-text">@Skill.ProficiencyLevel/5</span>
    </div>
</div>

@code
{
    [Parameter] public Skill Skill { get; set; } = new Skill();
}