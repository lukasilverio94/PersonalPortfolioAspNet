@using PersonalPortfolio.Models;

<div class="col-md-6 col-lg-4 col-sm-12 mb-4">
    <div class="card project-card h-100">
        @if (!string.IsNullOrEmpty(Project.ImageUrl))
        {
            <img src="@Project.ImageUrl" class="card-img-top" alt="@Project.Title"
                 style="height: 200px; object-fit: cover;">
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Project.Title</h5>
            <p class="card-text">@Project.Description</p>
            <div class="mb-3">
                @foreach (string tech in Project.TechStack.Split(separator: ',', StringSplitOptions.RemoveEmptyEntries))
                {
                    <span class="badge bg-secondary me-1">@tech.Trim()</span>
                }
            </div>
            <div class="mt-auto">
                @if (!string.IsNullOrEmpty(Project.LiveUrl))
                {
                    <a href="@Project.LiveUrl" class="btn btn-primary btn-sm me-2" target="_blank"
                       rel="noopener noreferrer">
                        Live Demo
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Project.GitHubUrl))
                {
                    <a href="@Project.GitHubUrl" class="btn btn-outline-dark btn-sm" target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                    </a>
                }
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter] public Project Project { get; set; } = new();
}
