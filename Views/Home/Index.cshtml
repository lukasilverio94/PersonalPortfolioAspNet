@model PersonalPortfolio.Models.HomeViewModel
@using PersonalPortfolio.Components

@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Hello, I'm Lucas</h1>
                <h3 class="h4 mb-4 text-light">Full-Stack ASP.NET Core Developer</h3>
                <p class="lead mb-4">
                    I create modern, responsive web applications using ASP.NET Core, Blazor, 
                    and the latest web technologies. Passionate about clean code and user
                    experience.
                </p>
                <div class="d-flex gap-3">
                    <a href="#projects" class="btn btn-light btn-lg">
                        <i class="fas fa-code me-2"></i>View My Work
                    </a>
                    <a href="#contact" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-envelope me-2"></i>Get In Touch
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://plus.unsplash.com/premium_vector-1757079281614-f06e0a57bdf8?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHx0b3BpYy1mZWVkfDEzfElmNjVBdU5PT3hRfHxlbnwwfHx8fHw%3D"
                     alt="Lucas" class="img-fluid rounded-circle" style="max-width: 300px;">
            </div>
        </div>
    </div>
</section>
<section id="projects" class="mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="h3 mb-2">Featured Projects</h2>
        <p class="text-muted mb-0">A selection of recent work and the technologies behind it.</p>
    </div>
    <div class="row">
        @foreach (var project in Model.Projects)
        {
            <component type="typeof(ProjectCard)" render-mode="ServerPrerendered" param-Project="project" />
        }
    </div>
</section>

<section class="mb-5">
    <h2 class="h3 mb-3">Skills</h2>
    <div class="row">
        @foreach (var skill in Model.Skills)
        {
            <component type="typeof(SkillCard)" render-mode="ServerPrerendered" param-Skill="skill" />
        }
    </div>
</section>

<section id="contact" class="row justify-content-center mb-4">
    <div class="col-lg-12 col-md-8">
        <component type="typeof(ContactForm)" render-mode="ServerPrerendered" />
    </div>
</section>
